# Copy this file to .env and replace every CHANGE_ME value before startup.
COMPOSE_PROJECT_NAME=enterprise-etl-quality

# Pinned official images
POSTGRES_IMAGE=postgres:16.15-bookworm
MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2022-CU21-ubuntu-22.04@sha256:b1395aa51b4ec39981883560f1379ea9eba2a1c0719bf8e6477902769316bb79
AIRFLOW_IMAGE=apache/airflow:3.3.1-python3.12
AIRFLOW_PROJECT_IMAGE=enterprise-etl-quality-airflow:3.3.1
PYTHON_BASE_IMAGE=python:3.12.12-slim-bookworm
REPORTING_API_IMAGE=enterprise-etl-quality-api:1.0.0

# PostgreSQL CRM source
CRM_POSTGRES_USER=crm_app
CRM_POSTGRES_PASSWORD=CHANGE_ME_CRM_PASSWORD
CRM_POSTGRES_HOST=crm-postgres
CRM_POSTGRES_PORT=5432
CRM_POSTGRES_DB=crm_source
CRM_POSTGRES_SSL_MODE=disable
CRM_POSTGRES_HOST_PORT=5433

# PostgreSQL warehouse and quality store
WAREHOUSE_POSTGRES_USER=etl_app
WAREHOUSE_POSTGRES_PASSWORD=CHANGE_ME_WAREHOUSE_PASSWORD
WAREHOUSE_POSTGRES_HOST=warehouse-postgres
WAREHOUSE_POSTGRES_PORT=5432
WAREHOUSE_POSTGRES_DB=quality_framework
WAREHOUSE_POSTGRES_SSL_MODE=disable
WAREHOUSE_POSTGRES_HOST_PORT=5432
REPORTING_API_PORT=8000
REPORTING_DB_POOL_SIZE=5
REPORTING_DB_MAX_OVERFLOW=5
CUSTOMER_STATUS_MOCK_PORT=8001
REPORTING_AUTH_ENABLED=true
REPORTING_DASHBOARD_USERNAME=admin
REPORTING_DASHBOARD_PASSWORD=CHANGE_ME_DASHBOARD_PASSWORD
REPORTING_ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN
REPORTING_OPERATOR_TOKEN=CHANGE_ME_OPERATOR_TOKEN
REPORTING_VIEWER_TOKEN=CHANGE_ME_VIEWER_TOKEN

# PostgreSQL Airflow metadata store
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=CHANGE_ME_AIRFLOW_DB_PASSWORD
AIRFLOW_DB_NAME=airflow

# SQL Server billing source
MSSQL_SA_PASSWORD=CHANGE_ME_Strong_SQLServer_Password_123!
MSSQL_APP_USER=billing_reader
MSSQL_APP_PASSWORD=CHANGE_ME_Strong_BillingReader_Password_123!
MSSQL_HOST=billing-sqlserver
MSSQL_PORT=1433
MSSQL_HOST_PORT=1433
MSSQL_DATABASE=billing_source
MSSQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true

# SQLAlchemy connection pools
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10

# Customer-status REST API (the token is sent only in the Authorization header)
CUSTOMER_STATUS_API_URL=http://customer-status-mock:8001/v1/customer-status
CUSTOMER_STATUS_API_TOKEN=CHANGE_ME_STATUS_API_TOKEN
CUSTOMER_STATUS_API_CONNECT_TIMEOUT_SECONDS=5
CUSTOMER_STATUS_API_READ_TIMEOUT_SECONDS=30
CUSTOMER_STATUS_API_MAX_RETRIES=3
CUSTOMER_STATUS_API_BACKOFF_SECONDS=0.5

# Airflow pipeline recovery and bounded dbt execution
PIPELINE_DELIVERY_LEASE_SECONDS=7200
DBT_THREADS=4
DBT_COMMAND_TIMEOUT_SECONDS=1800

# Great Expectations reads one encoded URL so credentials remain outside YAML.
GX_WAREHOUSE_CONNECTION_STRING=postgresql+psycopg://etl_app:CHANGE_ME_WAREHOUSE_PASSWORD@warehouse-postgres:5432/quality_framework

# Airflow runtime
AIRFLOW_UID=50000
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME_AIRFLOW_ADMIN_PASSWORD
AIRFLOW_ADMIN_EMAIL=admin@example.invalid
AIRFLOW_FERNET_KEY=CHANGE_ME_WITH_A_VALID_FERNET_KEY
AIRFLOW_API_SECRET_KEY=CHANGE_ME_WITH_A_RANDOM_API_SECRET
AIRFLOW_JWT_SECRET=CHANGE_ME_WITH_A_RANDOM_JWT_SECRET
