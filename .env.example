# Copy this file to .env and replace every CHANGE_ME value before startup.
COMPOSE_PROJECT_NAME=enterprise-etl-quality

# Pinned official images
POSTGRES_IMAGE=postgres:16.15-bookworm
MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2022-CU21-ubuntu-22.04@sha256:b1395aa51b4ec39981883560f1379ea9eba2a1c0719bf8e6477902769316bb79
AIRFLOW_IMAGE=apache/airflow:3.3.1-python3.12

# PostgreSQL CRM source
CRM_POSTGRES_USER=crm_app
CRM_POSTGRES_PASSWORD=CHANGE_ME_CRM_PASSWORD
CRM_POSTGRES_DB=crm_source
CRM_POSTGRES_PORT=5433

# PostgreSQL warehouse and quality store
WAREHOUSE_POSTGRES_USER=etl_app
WAREHOUSE_POSTGRES_PASSWORD=CHANGE_ME_WAREHOUSE_PASSWORD
WAREHOUSE_POSTGRES_DB=quality_framework
WAREHOUSE_POSTGRES_PORT=5432

# PostgreSQL Airflow metadata store
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=CHANGE_ME_AIRFLOW_DB_PASSWORD
AIRFLOW_DB_NAME=airflow

# SQL Server billing source
MSSQL_SA_PASSWORD=CHANGE_ME_Strong_SQLServer_Password_123!
MSSQL_PORT=1433

# Airflow runtime
AIRFLOW_UID=50000
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME_AIRFLOW_ADMIN_PASSWORD
AIRFLOW_ADMIN_EMAIL=admin@example.invalid
AIRFLOW_FERNET_KEY=CHANGE_ME_WITH_A_VALID_FERNET_KEY
AIRFLOW_API_SECRET_KEY=CHANGE_ME_WITH_A_RANDOM_API_SECRET
AIRFLOW_JWT_SECRET=CHANGE_ME_WITH_A_RANDOM_JWT_SECRET
